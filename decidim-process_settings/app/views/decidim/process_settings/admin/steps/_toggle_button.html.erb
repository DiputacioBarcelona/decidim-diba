<% component = current_participatory_process.components.find_by(manifest_name: "process_settings") %>
<% if component && allowed_to?(:update, :process, process: current_participatory_process) %>
  <% enabled = component.settings.automatic_step_change %>
  <button type="button" class="button button__sm button__secondary" data-dialog-open="process-settings-dialog">
    <%= t("decidim.process_settings.admin.steps.toggle.button") %>:
    <strong><%= enabled ? t("decidim.process_settings.admin.steps.toggle.enabled") : t("decidim.process_settings.admin.steps.toggle.disabled") %></strong>
  </button>
<% end %>
